# ==============================================================================
# JICA Ice Logistics - Python FastAPI Backend Environment Configuration
# ==============================================================================

# Server Environment (development | production)
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------------------------
# 1. Supabase Service Role (Server-Side Only - Full DB Privileges, Bypass RLS)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# NEVER expose this key to jica-web or jica-mobile client bundles!
# ------------------------------------------------------------------------------
SUPABASE_URL=https://hpklxmfxoautfdqjgrgn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Google Cloud Server API Key (For Routes / Directions API Proxy & Cache)
# Enabled APIs: Routes API, Directions API
# IP-restricted to Railway egress IP or unrestricted server key
# ------------------------------------------------------------------------------
GOOGLE_ROUTES_SERVER_KEY=your_google_cloud_server_key_here

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins (Comma-separated)
# Local: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://jica-ice-web.vercel.app

# ------------------------------------------------------------------------------
# 4. Route Caching & Operational Parameters (Zero-Overage Controls)
# ------------------------------------------------------------------------------
ROUTE_CACHE_TTL_MINUTES=10
GPS_LOG_RETENTION_DAYS=180
TIMEZONE=Asia/Manila
